      "title": "Project Usage Percent",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "vstorage.account_stats.used_percent",
          "statistic": "avg",
          "filters": [
            {
              "key": "product",
              "value": "vstorage"
            },
            {
              "key": "project_id",
              "value": "$project"
            }
          ],
          "groupBy": [],
          "alias": "vstorage.account_stats.used_percent"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#aa00ff"
          }
        },
        "overrides": []
      },
      "interval": "60s",
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
