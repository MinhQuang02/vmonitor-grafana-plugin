  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "greennode-vmonitor-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "database",
        "type": "query",
        "label": "Database",
        "datasource": {
          "type": "greennode-vmonitor-datasource",
          "uid": "${datasource}"
