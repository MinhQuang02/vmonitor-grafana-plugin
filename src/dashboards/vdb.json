      "title": "Active Connections",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "vdb.postgresql.connections",
          "statistic": "avg",
          "filters": [
            {
              "key": "product",
              "value": "vdb"
            },
            {
              "key": "engine",
              "value": "PostgreSQL"
            },
            {
              "key": "database_id",
              "value": "$database"
            }
          ],
          "groupBy": [],
          "alias": "active_conn"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "active_conn"
