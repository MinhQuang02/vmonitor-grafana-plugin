{
  "uid": "vmonitor-vdb-postgre-cluster",
  "title": "vMonitor / vDB (Relational / MemoryStore Cluster)",
  "tags": [
    "vmonitor",
    "greennode",
    "vdb-postgre"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "greennode-vmonitor-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "cluster",
        "type": "query",
        "label": "PostgreSQL cluster",
        "datasource": {
          "type": "greennode-vmonitor-datasource",
          "uid": "${datasource}"
        },
        "query": "infrastructure(vdb-cluster)",
        "definition": "infrastructure(vdb-cluster)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false,
        "regex": ""
      },
      {
        "name": "datname",
        "type": "query",
        "label": "Database",
        "datasource": {
          "type": "greennode-vmonitor-datasource",
          "uid": "${datasource}"
        },
        "query": "dimensionValues(vdb.pg.pg_stat_database_tup_fetched, datname)",
        "definition": "dimensionValues(vdb.pg.pg_stat_database_tup_fetched, datname)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "includeAll": true,
        "allValue": "*",
        "multi": false,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL Online Nodes",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "vdb.pg.pg_up",
          "statistic": "count",
          "filters": [
            {
              "key": "product",
              "value": "vdb-postgre"
            },
            {
              "key": "cluster_id",
              "value": "$cluster"
            }
          ],
          "groupBy": [],
          "alias": "Nodes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0091ea"
          }
        },
        "overrides": []
      },
      "interval": "60s",
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 2,
      "title": "PostgreSQL Version",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "vdb.pg.pg_version",
          "statistic": "avg",
          "filters": [
            {
              "key": "cluster_id",
              "value": "$cluster"
            }
          ],
          "groupBy": [
            "short_version"
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0091ea"
          }
        },
        "overrides": []
      },
      "interval": "60s",
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area"
