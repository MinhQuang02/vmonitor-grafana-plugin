{
  "uid": "vmonitor-vstorage-bucket",
  "title": "vMonitor / vStorage (Bucket)",
  "tags": [
    "vmonitor",
    "greennode",
    "vstorage-bucket"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "60s",
  "time": {
    "from": "now-90m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "greennode-vmonitor-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "region",
        "type": "query",
        "label": "Region",
        "datasource": {
          "type": "greennode-vmonitor-datasource",
          "uid": "${datasource}"
        },
        "query": "regions(vstorage-bucket)",
        "definition": "regions(vstorage-bucket)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false,
        "regex": ""
      },
      {
        "name": "bucket",
        "type": "query",
        "label": "Bucket",
        "datasource": {
          "type": "greennode-vmonitor-datasource",
          "uid": "${datasource}"
        },
        "query": "infrastructure(vstorage-bucket, $region)",
        "definition": "infrastructure(vstorage-bucket, $region)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Bucket Objects",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "vstorage.bucket_stats.object_count",
          "statistic": "max",
          "filters": [
            {
              "key": "product",
              "value": "vstorage"
            },
            {
              "key": "bucket",
              "value": "$bucket"
            },
            {
              "key": "region",
              "value": "$region"
            }
          ],
          "groupBy": [],
          "alias": "Objects"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#00b8d4"
          }
        },
        "overrides": []
      },
      "interval": "60s",
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
