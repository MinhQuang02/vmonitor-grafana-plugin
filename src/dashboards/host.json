{
  "uid": "vmonitor-host",
  "title": "vMonitor / Host",
  "tags": [
    "vmonitor",
    "greennode",
    "host"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "",
  "time": {
    "from": "now-60m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "query": "greennode-vmonitor-datasource",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "includeAll": false,
        "multi": false
      },
      {
        "name": "host",
        "type": "query",
        "label": "Host",
        "datasource": {
          "type": "greennode-vmonitor-datasource",
          "uid": "${datasource}"
        },
        "query": "infrastructure(host)",
        "definition": "infrastructure(host)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage(percent)",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "cpu.usage_guest",
          "statistic": "avg",
          "filters": [
            {
              "key": "host",
              "value": "$host"
            }
          ],
          "groupBy": [],
          "alias": "cpu.usage_guest:host:$host"
        },
        {
          "refId": "B",
          "queryMode": "metric",
          "metricName": "cpu.usage_user",
          "statistic": "avg",
          "filters": [
            {
              "key": "host",
              "value": "$host"
            }
          ],
          "groupBy": [],
          "alias": "cpu.usage_user:host:$host"
        },
        {
          "refId": "C",
          "queryMode": "metric",
          "metricName": "cpu.usage_iowait",
          "statistic": "avg",
          "filters": [
            {
              "key": "host",
              "value": "$host"
            }
          ],
          "groupBy": [],
          "alias": "cpu.usage_iowait:host:$host"
        },
        {
          "refId": "D",
          "queryMode": "metric",
          "metricName": "cpu.usage_idle",
          "statistic": "avg",
          "filters": [
            {
              "key": "host",
              "value": "$host"
            }
          ],
          "groupBy": [],
          "alias": "cpu.usage_idle:host:$host"
        },
        {
          "refId": "E",
          "queryMode": "metric",
          "metricName": "cpu.usage_system",
          "statistic": "avg",
          "filters": [
            {
              "key": "host",
              "value": "$host"
            }
          ],
          "groupBy": [],
          "alias": "cpu.usage_system:host:$host"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cpu.usage_guest:host:$host"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff6d00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu.usage_user:host:$host"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#c51162"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu.usage_iowait:host:$host"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ffab00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu.usage_idle:host:$host"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#00b8d4"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cpu.usage_system:host:$host"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d50000"
                }
              }
            ]
          }
        ]
      },
      "interval": "60s",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
