  "panels": [
    {
      "id": 1,
      "title": "Current CPU Utilization",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 7,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "vdb.cpu.percent",
          "statistic": "avg",
          "filters": [
            {
              "key": "product",
              "value": "vdb"
            },
            {
              "key": "engine",
              "value": "PostgreSQL"
            },
            {
              "key": "database_id",
              "value": "$database"
            }
          ],
          "groupBy": [],
          "alias": "cpu_utilization"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#00c853"
          }
        },
        "overrides": []
      },
      "interval": "60s",
      "type": "stat",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area"
      }
    },
