              "value": "postgres"
            },
            {
              "key": "cluster_id",
              "value": "$cluster"
            }
          ],
          "groupBy": [
            "node_name"
          ],
          "rate": "per_second",
          "hide": true
        },
        {
          "refId": "B",
          "queryMode": "metric",
          "metricName": "vdb.pg.node_spec_cpu_quota",
          "statistic": "avg",
          "filters": [
            {
              "key": "product",
