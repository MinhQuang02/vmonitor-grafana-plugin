        "query": "infrastructure(vdb)",
        "definition": "infrastructure(vdb)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "current": {},
        "options": [],
        "includeAll": false,
        "multi": false,
        "regex": ""
