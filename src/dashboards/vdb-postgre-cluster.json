    {
      "id": 3,
      "title": "Mem Usage (Percent)",
      "datasource": {
        "type": "greennode-vmonitor-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 7,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "metric",
          "metricName": "vdb.pg.node_memory_working_set_bytes",
          "statistic": "avg",
          "filters": [
            {
              "key": "product",
              "value": "vdb-postgre"
            },
            {
              "key": "metrics_path",
              "value": "/metrics/cadvisor"
            },
            {
              "key": "container",
              "value": "postgres"
            },
            {
              "key": "cluster_id",
              "value": "$cluster"
            }
          ],
          "groupBy": [
            "node_name"
          ],
          "hide": true
        },
        {
          "refId": "B",
          "queryMode": "metric",
          "metricName": "vdb.pg.node_spec_memory_limit_bytes",
          "statistic": "avg",
          "filters": [
            {
              "key": "product",
              "value": "vdb-postgre"
            },
            {
              "key": "metrics_path",
              "value": "/metrics/cadvisor"
            },
            {
              "key": "container",
              "value": "postgres"
            },
            {
              "key": "cluster_id",
              "value": "$cluster"
            }
          ],
          "groupBy": [
            "node_name"
          ],
          "hide": true
        },
        {
          "refId": "C",
          "queryMode": "expression",
          "expression": "A / B * 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true,
            "lineInterpolation": "linear"
          }
        },
        "overrides": []
      },
      "interval": "60s",
      "type": "timeseries",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
